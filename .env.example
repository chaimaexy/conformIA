# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Mistral AI - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Supabase - Project Settings > API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secrète : backend uniquement, ne jamais l'exposer au frontend
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Project Settings > Database > Connection string (pooler, mode session)
DATABASE_URL=
