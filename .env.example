# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Mistral AI - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Cohere (reranker) - https://dashboard.cohere.com/api-keys (clé d'essai gratuite, non commerciale)
COHERE_API_KEY=
# Rerankers concurrents, pour la comparaison (optionnels)
# Voyage AI - https://dashboard.voyageai.com (quota gratuit à l'inscription)
VOYAGE_API_KEY=
# Jina AI - https://jina.ai (quota gratuit, non commercial)
JINA_API_KEY=

# Cache des modèles Hugging Face (optionnel, défaut : data/cache/hf). Utile si le disque est plein.
# MODELS_CACHE_DIR=C:/Users/<toi>/.cache/conformia/hf

# Supabase - Project Settings > API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secrète : backend uniquement, ne jamais l'exposer au frontend
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Project Settings > Database > Connection string (pooler, mode session)
DATABASE_URL=
