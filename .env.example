# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Mistral AI - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Cohere (reranker) - https://dashboard.cohere.com/api-keys (clé d'essai gratuite, non commerciale)
COHERE_API_KEY=
# Jina AI (reranker concurrent, pour la comparaison ; optionnel) - https://jina.ai (quota gratuit, non commercial)
JINA_API_KEY=

# Cache des modèles Hugging Face (optionnel, défaut : data/cache/hf). Utile si le disque est plein.
# MODELS_CACHE_DIR=C:/Users/<toi>/.cache/conformia/hf

# Supabase - Project Settings > API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secrète : backend uniquement, ne jamais l'exposer au frontend
SUPABASE_SECRET_KEY=
# Clés publiques qui vérifient les sessions (défaut : <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=
# Analyses, conversations et état de LangGraph. Bouton « Connect » du projet > Session pooler
# (port 5432 ; pas la connexion directe, en IPv6 seulement). Vide : SQLite dans data/cache.
DATABASE_URL=

# File des analyses (docker compose la renseigne) ; vide : file dans le processus de l'API
# REDIS_URL=redis://localhost:6379/0

# Poste de développement seulement, avec SQLite : pas de jeton, un utilisateur local fixe
# AUTH_DISABLED=true
